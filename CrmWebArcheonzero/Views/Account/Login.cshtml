@{
    ViewData["Title"] = "Вход";
}

<h2>Вход в CRM</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (ViewBag.DbMessage != null)
{
    <div class="alert alert-success">@ViewBag.DbMessage</div>
}

<!-- Кнопки выбора базы -->
<form method="post" asp-action="SelectDatabase">
    <div class="form-group">
        <label>Выберите базу данных:</label>
        <div>
            <button type="submit" name="selectedProvider" value="Sqlite" class="btn btn-outline-primary">SQLite</button>
            <button type="submit" name="selectedProvider" value="PostgreSQL" class="btn btn-outline-primary">PostgreSQL</button>
            <button type="submit" name="selectedProvider" value="SqlServer" class="btn btn-outline-primary">SQL Server</button>
        </div>
    </div>
</form>

<hr />

<!-- Форма входа -->
<form method="post" asp-action="Login">
    <div class="form-group">
        <label>Логин</label>
        <input type="text" name="username" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Пароль</label>
        <input type="password" name="password" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Войти</button>
</form>