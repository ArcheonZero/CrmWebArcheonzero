@{
    ViewData["Title"] = "Импорт клиентов";
}

<h2>Импорт клиентов из Excel</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post" enctype="multipart/form-data" asp-action="Excel">
    <div class="form-group mb-3">
        <label for="file" class="form-label">Выберите Excel-файл (.xlsx)</label>
        <input type="file" name="file" class="form-control" accept=".xlsx" required />
    </div>
    <button type="submit" class="btn btn-primary">📥 Загрузить и импортировать</button>
    <a asp-controller="Clients" asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</form>