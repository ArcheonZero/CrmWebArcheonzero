@model List<CrmWebArcheonzero.Models.ChatMessage>

<h2>💬 Чат</h2>

<div style="max-height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 5px; background: #f9f9f9;">
    @if (Model != null && Model.Any())
    {
        foreach (var msg in Model.OrderBy(m => m.SentAt))
        {
            <div style="margin-bottom: 10px; border-bottom: 1px solid #eee; padding-bottom: 8px;">
                <div style="font-weight: bold; color: #000;">
                    @msg.User.Username
                    <span style="font-weight: normal;">@msg.User.FullName</span>
                    <span style="color: #555; font-weight: normal;">@msg.User.Email</span>
                    <span style="color: #555; font-weight: normal;">(Роль: @msg.User.Role)</span>
                    <span style="color: #888; font-weight: normal; font-size: 0.8rem;"> — @msg.SentAt.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div style="color: #000; background: white; padding: 8px; border-radius: 5px; border: 1px solid #eee; margin-top: 4px;">
                    @msg.Message
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">Сообщений пока нет. Напишите первое!</p>
    }
</div>

<form method="post" asp-action="SendMessage" class="mt-3">
    <div class="input-group">
        <input type="text" name="message" class="form-control" placeholder="Введите сообщение..." required />
        <button type="submit" class="btn btn-primary">➤ Отправить</button>
    </div>
</form>