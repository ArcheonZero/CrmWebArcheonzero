@model CrmWebArcheonzero.Models.Client
@using System.Security.Claims

@if (User.Identity.IsAuthenticated)
{
    <div>
        <span>Пользователь: @User.Identity.Name</span>
        <span class="badge bg-info">@User.FindFirst(ClaimTypes.Role)?.Value</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["ImportErrors"] != null)
{
    <div class="alert alert-danger">
        <strong>Ошибки импорта:</strong>
        <ul>
            @foreach (var error in TempData["ImportErrors"].ToString().Split("<br />", StringSplitOptions.RemoveEmptyEntries))
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
@{
    ViewData["Title"] = "Удалить клиента";
}

<h1>🗑 Удалить клиента</h1>

<h3>Вы уверены, что хотите удалить этого клиента?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">
            Имя
        </dt>
        <dd class="col-sm-10">
            @Model.Name
        </dd>
        <dt class="col-sm-2">
            Телефон
        </dt>
        <dd class="col-sm-10">
            @Model.Phone
        </dd>
        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Model.Email
        </dd>
        <dt class="col-sm-2">
            Компания
        </dt>
        <dd class="col-sm-10">
            @Model.Company
        </dd>
        <dt class="col-sm-2">
            Статус
        </dt>
        <dd class="col-sm-10">
            @Model.Status
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    </form>
</div>