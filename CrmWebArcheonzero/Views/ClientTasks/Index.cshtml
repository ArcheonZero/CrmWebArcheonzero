@model IEnumerable<CrmWebArcheonzero.Models.ClientTask>

<h2>Задачи для клиента: @ViewBag.ClientName</h2>

<p>
    <a asp-action="Create" asp-route-clientId="@ViewBag.ClientId" class="btn btn-primary">➕ Новая задача</a>
    <a asp-controller="Clients" asp-action="Details" asp-route-id="@ViewBag.ClientId" class="btn btn-secondary">⬅ Назад к клиенту</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Название</th>
            <th>Описание</th>
            <th>Срок</th>
            <th>Приоритет</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>@task.DueDate.ToString("dd.MM.yyyy")</td>
                <td>@task.Priority</td>
                <td>@(task.IsCompleted ? "✅ Выполнена" : "⏳ Активна")</td>
                <td>
                    <form asp-action="Toggle" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@task.Id" />
                        <button type="submit" class="btn btn-sm @(task.IsCompleted ? "btn-warning" : "btn-success")">
                            @(task.IsCompleted ? "↩️ Вернуть" : "✅ Завершить")
                        </button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-primary">✏️</a>
                    <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-danger">🗑️</a>
                </td>
            </tr>
        }
    </tbody>
</table>