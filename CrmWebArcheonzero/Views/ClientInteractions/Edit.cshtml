@model CrmWebArcheonzero.Models.Interaction

<h2>✏️ Редактировать взаимодействие</h2>

<form method="post" asp-action="Edit">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="form-group mb-2">
        <label for="type" class="form-label">Тип</label>
        <select name="type" id="type" class="form-select">
            <option value="Call" selected="@(Model.Type == "Call")">Звонок</option>
            <option value="Email" selected="@(Model.Type == "Email")">Письмо</option>
            <option value="Meeting" selected="@(Model.Type == "Meeting")">Встреча</option>
        </select>
    </div>
    <div class="form-group mb-2">
        <label for="description" class="form-label">Описание</label>
        <input type="text" name="description" id="description" class="form-control" value="@Model.Description" required />
    </div>
    <div class="form-group mb-2">
        <label for="date" class="form-label">Дата и время</label>
        <input type="datetime-local" name="date" id="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")" required />
    </div>
    <button type="submit" class="btn btn-primary">💾 Сохранить</button>
    <a asp-action="Index" asp-route-clientId="@Model.ClientId" class="btn btn-secondary">Отмена</a>
</form>