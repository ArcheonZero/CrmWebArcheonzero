@model IEnumerable<CrmWebArcheonzero.Models.Note>

<h2>Заметки для клиента: @ViewBag.ClientName</h2>

<form method="post" asp-action="Create" asp-route-clientId="@ViewBag.ClientId" class="mb-3">
    <div class="input-group">
        <input type="text" name="content" class="form-control" placeholder="Введите заметку..." required />
        <button type="submit" class="btn btn-primary">➕ Добавить</button>
    </div>
</form>

<ul class="list-group">
    @if (Model != null && Model.Any())
    {
        foreach (var note in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@note.Content</span>
                <span class="badge bg-secondary">@note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                <div>
                    <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-warning">✏️</a>
                    <form method="post" asp-action="Delete" style="display: inline;">
                        <input type="hidden" name="id" value="@note.Id" />
                        <input type="hidden" name="clientId" value="@ViewBag.ClientId" />
                        <button type="submit" class="btn btn-sm btn-danger">🗑</button>
                    </form>
                </div>
            </li>
        }
    }
    else
    {
        <li class="list-group-item text-muted">Нет заметок</li>
    }
</ul>

<div class="mt-3">
    <a asp-controller="Clients" asp-action="Details" asp-route-id="@ViewBag.ClientId" class="btn btn-secondary">⬅ Назад к клиенту</a>
</div>