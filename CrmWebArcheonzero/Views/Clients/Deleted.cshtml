@model List<CrmWebArcheonzero.Models.Client>
@using System.Security.Claims

@if (User.Identity.IsAuthenticated)
{
    <div>
        <span>Пользователь: @User.Identity.Name</span>
        <span class="badge bg-info">@User.FindFirst(ClaimTypes.Role)?.Value</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["ImportErrors"] != null)
{
    <div class="alert alert-danger">
        <strong>Ошибки импорта:</strong>
        <ul>
            @foreach (var error in TempData["ImportErrors"].ToString().Split("<br />", StringSplitOptions.RemoveEmptyEntries))
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
@{
    ViewData["Title"] = "Корзина";
}

<h1>🗑 Корзина (удалённые клиенты)</h1>

<table class="table">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Телефон</th>
            <th>Email</th>
            <th>Удалён</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.Name</td>
                <td>@client.Phone</td>
                <td>@client.Email</td>
                <td>@client.DeletedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Restore" asp-route-id="@client.Id" class="btn btn-sm btn-success">Восстановить</a>
                    <form asp-action="PermanentDelete" asp-route-id="@client.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить клиента окончательно? Это действие нельзя отменить!')">🗑 Окончательно</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Назад к списку</a>