@model List<CrmWebArcheonzero.Models.User>
@using System.Security.Claims

@if (User.Identity.IsAuthenticated)
{
    <div>
        <span>Пользователь: @User.Identity.Name</span>
        <span class="badge bg-info">@User.FindFirst(ClaimTypes.Role)?.Value</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["ImportErrors"] != null)
{
    <div class="alert alert-danger">
        <strong>Ошибки импорта:</strong>
        <ul>
            @foreach (var error in TempData["ImportErrors"].ToString().Split("<br />", StringSplitOptions.RemoveEmptyEntries))
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
@{
    ViewData["Title"] = "Управление пользователями";
}

<h1>👤 Управление пользователями</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Логин</th>
            <th>Имя</th>
            <th>Email</th>
            <th>Роль</th>
            <th>Активен</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Username</td>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    <form method="post" asp-action="ChangeRole" style="display: inline;">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <select name="role" class="form-select form-select-sm" style="width: auto; display: inline;" onchange="this.form.submit()">
                            <option value="User" selected="@(user.Role == "User")">User</option>
                            <option value="Manager" selected="@(user.Role == "Manager")">Manager</option>
                            <option value="SuperManager" selected="@(user.Role == "SuperManager")">SuperManager</option>
                            <option value="Admin" selected="@(user.Role == "Admin")">Admin</option>
                        </select>
                    </form>
                </td>
                <td>
                    <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                        @(user.IsActive ? "Активен" : "Заблокирован")
                    </span>
                </td>
               <td>
                    <form method="post" asp-action="UpdateUser" style="display: inline-block;">
                        <input type="hidden" name="userId" value="@user.Id" />
        
                        <input type="text" name="username" value="@user.Username" 
                               class="form-control form-control-sm" style="width: 100px; display: inline-block;" />
        
                        <input type="text" name="fullName" value="@user.FullName" 
                               class="form-control form-control-sm" style="width: 120px; display: inline-block;" />
        
                        <input type="email" name="email" value="@user.Email" 
                               class="form-control form-control-sm" style="width: 150px; display: inline-block;" />
        
                        <button type="submit" class="btn btn-sm btn-primary">💾</button>
                    </form>

                    <!-- Форма для блокировки -->
                    <form method="post" asp-action="ToggleUserStatus" style="display: inline-block;">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")">
                            @(user.IsActive ? "🔒" : "🔓")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<h3 class="mt-4">➕ Добавить пользователя</h3>
<form method="post" asp-action="CreateUser">
    <div class="row">
        <div class="col-md-3">
            <input type="text" name="username" class="form-control" placeholder="Логин" required />
        </div>
        <div class="col-md-3">
            <input type="password" name="password" class="form-control" placeholder="Пароль" required />
        </div>
        <div class="col-md-3">
            <input type="email" name="email" class="form-control" placeholder="Email" required />
        </div>
        <div class="col-md-2">
            <select name="role" class="form-select">
                <option value="User">User</option>
                <option value="Manager">Manager</option>
                <option value="SuperManager">SuperManager</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary">Добавить</button>
        </div>
    </div>
</form>

<a asp-action="Index" class="btn btn-secondary mt-3">Назад</a>