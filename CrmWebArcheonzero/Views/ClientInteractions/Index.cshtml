@model IEnumerable<CrmWebArcheonzero.Models.Interaction>

<h2>Взаимодействия для клиента: @ViewBag.ClientName</h2>

<form method="post" asp-action="Create" asp-route-clientId="@ViewBag.ClientId" class="mb-3">
    <div class="row">
        <div class="col-md-3">
            <select name="type" class="form-select" required>
                <option value="Call">Звонок</option>
                <option value="Email">Письмо</option>
                <option value="Meeting">Встреча</option>
            </select>
        </div>
        <div class="col-md-4">
            <input type="text" name="description" class="form-control" placeholder="Описание" required />
        </div>
        <div class="col-md-3">
            <input type="datetime-local" name="date" class="form-control" required />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">➕ Добавить</button>
        </div>
    </div>
</form>

<ul class="list-group">
    @if (Model != null && Model.Any())
    {
        foreach (var interaction in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge @(interaction.Type == "Call" ? "bg-success" : interaction.Type == "Email" ? "bg-info" : "bg-warning")">
                        @interaction.Type
                    </span>
                    @interaction.Description
                    <span class="badge bg-secondary ms-2">@interaction.Date.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div>
                    <a asp-action="Edit" asp-route-id="@interaction.Id" class="btn btn-sm btn-warning">✏️</a>
                    <form method="post" asp-action="Delete" style="display: inline;">
                        <input type="hidden" name="id" value="@interaction.Id" />
                        <input type="hidden" name="clientId" value="@ViewBag.ClientId" />
                        <button type="submit" class="btn btn-sm btn-danger">🗑</button>
                    </form>
                </div>
            </li>
        }
    }
    else
    {
        <li class="list-group-item text-muted">Нет взаимодействий</li>
    }
</ul>

<div class="mt-3">
    <a asp-controller="Clients" asp-action="Details" asp-route-id="@ViewBag.ClientId" class="btn btn-secondary">⬅ Назад к клиенту</a>
</div>