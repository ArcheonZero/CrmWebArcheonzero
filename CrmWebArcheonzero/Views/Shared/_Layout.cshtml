<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CrmWebArcheonzero</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CrmWebArcheonzero.styles.css" asp-append-version="true" />
    <style>
    body {
        background-color: #0F1A2E;
        color: #E6EDF5;
    }
    .navbar {
        background: linear-gradient(90deg, #0D1B3A, #1A2B6B) !important;
        border-bottom: 2px solid #D4AF37 !important;
    }
    .navbar-brand {
        color: #D4AF37 !important;
    }
    .btn-primary {
        background-color: #2A3B8C !important;
        border-color: #2A3B8C !important;
    }
</style>
</head>
<body>
        <header>
        @await Html.PartialAsync("_TopNav")
        </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CrmWebArcheonzero - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>